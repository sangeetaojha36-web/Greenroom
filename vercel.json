{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{data/**,public/**,frontend/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js?path=/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?path=/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
